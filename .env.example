# Runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorflow
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (required when auth is implemented)
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Rendering (FFmpeg is required for rendering features only)
FFMPEG_PATH=ffmpeg
RENDER_OUTPUT_DIR=./.data/renders

# Object storage (required for production asset persistence)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# AI providers (choose providers per feature; not required for local boot)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Speech-to-text providers (captions/transcription)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Text-to-speech providers (voice generation)
ELEVENLABS_API_KEY=
PLAYHT_API_KEY=

# Billing (subscriptions and checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
